{
  "name": "line-ending-selector",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Show and change the line ending used by the current editor.",
  "keywords": [
    "crlf",
    "lf",
    "eol",
    "newline",
    "cr"
  ],
  "repository": "https://github.com/lumine-code/line-ending-selector",
  "bugs": {
    "url": "https://github.com/lumine-code/line-ending-selector/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "{% if keys['line-ending-selector:show'] %}You can switch the current file between LF and CRLF with {{ 'line-ending-selector:show' | keystroke }}{% else %}The status bar shows whether the current file uses LF or CRLF, and clicking it converts the file.{% endif %}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "defaultLineEnding": {
      "title": "Default line ending",
      "description": "Line ending to use for new files",
      "type": "string",
      "enum": [
        "OS Default",
        "LF",
        "CRLF"
      ],
      "default": "OS Default"
    }
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "dependencies": {
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#3187fd4c2dd47f50044efe51deb7c662ddac437c"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
